{
  "name": "tuble",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite build && vite preview",
    "deploy": "vite build && wrangler d1 migrations apply tuble --remote && wrangler deploy",
    "data:network": "bun run scripts/build-network.ts",
    "data:prompts": "bun run scripts/generate-prompts.ts",
    "data:schedule": "bun run scripts/build-schedule.ts",
    "icons": "bun run scripts/build-icons.ts",
    "db:migrate:local": "wrangler d1 migrations apply tuble --local",
    "cf-typegen": "wrangler types",
    "test": "bun test",
    "typecheck": "wrangler types > /dev/null && tsc --noEmit -p tsconfig.json && tsc --noEmit -p app/tsconfig.json && tsc --noEmit -p worker/tsconfig.json"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.66.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/bun": "^1.4.4",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "node-html-parser": "^9.0.6",
    "opentype.js": "^2.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.156.0"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
